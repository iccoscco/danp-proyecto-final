# ==========================================
# Ignorar Archivos de Configuración y Secretos (Crucial)
# ==========================================
# Esto evita que subas contraseñas, claves de API y tokens de Supabase.
.env
.env.local
.env.*.local
!/Backend/.env.example  # Ejemplo: Si quieres subir una plantilla vacía para guiar a otros

# ==========================================
# Entorno de Sistema Operativo y VS Code
# ==========================================
# Archivos basura de macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Archivos basura de Windows
# Thumbnails (miniaturas)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
# Papelera de reciclaje
$RECYCLE.BIN/
# Archivos temporales de Office
~$*
# Carpetas de configuración de VS Code (a veces la gente las comparte, pero mejor no)
.vscode/
*.code-workspace
# Archivos temporales del sistema
*.tmp
*.bak

# ==========================================
# Backend: Python (FastAPI)
# ==========================================
# Carpetas de dependencias
__pycache__/
*.py[cod]
*$py.class
venv/
.env/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Distribución de paquetes
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Logs y bases de datos locales de desarrollo
*.log
*.sqlite
*.sqlite3

# ==========================================
# Frontend: Next.js (Node.js/JavaScript)
# ==========================================
# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Versiones de paquetes
package-lock.json  # Algunos equipos prefieren subir esto, otros no. Si es un proyecto en equipo, suele subirse. Si es solo tuyo, puedes ignorarlo.
pnpm-lock.yaml

# Salida de Next.js (archivos de compilación)
.next/
out/

# Archivos de entorno de Next.js (ya cubiertos arriba, pero recordatorio)
# .env.local

# ==========================================
# Android: Android Studio (Kotlin/Java)
# ==========================================
# Archivos de compilación (Gradle)
build/
.gradle/
captures/

# Archivos de configuración local (aquí es donde se guardan rutas específicas de tu PC)
local.properties
gradle.properties
*.iml

# Configuración de Android Studio
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries/
.idea/vcs.xml

# Archivos de emuladores/dispositivos virtuales
.emulator/
*.hprof

# Archivos de pruebas y reporte de cobertura
/coverage/
*.apk
output.json

# ==========================================
# Bases de Datos (Opcional, pero recomendado no subir)
# ==========================================
db_data/  # Ejemplo si usas docker-compose para una DB local
*.dump